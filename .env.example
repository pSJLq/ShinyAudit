# Somnia Testnet (Shannon)
NEXT_PUBLIC_SOMNIA_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_RPC=https://api.infra.testnet.somnia.network/
NEXT_PUBLIC_SOMNIA_EXPLORER=https://shannon-explorer.somnia.network/
NEXT_PUBLIC_SOMNIA_AGENT_PLATFORM=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# ─── Server-side only — DO NOT commit ─────────────────────────────
# Orchestrator EOA that signs escrow.dispatchFor(). Must hold ≥ 0.5 STT for gas.
PRIVATE_KEY=0x_REPLACE_ME_WITH_ROTATED_KEY
DEPLOYER_ADDRESS=0x_REPLACE_ME_WITH_ROTATED_ADDRESS

# Public origin where THIS service is deployed. On Vercel: set to the project's
# production URL (e.g. https://shinyaudit.vercel.app). Used by:
#   • orchestrator's LOCAL identity probe (bypass on-chain, 0 STT)
#   • on-chain identity_* tools' selectors (Somnia validators fetch this URL)
# In local dev defaults to http://127.0.0.1:3000 — fine for the local probe,
# breaks the on-chain identity tools (validators can't reach private network).
BASE_URL=https://shinyaudit.vercel.app
